# Hosted Supabase project (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) — safe for the browser. Never put the secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public origin of this app, used for auth email / OAuth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# FastAPI backend that /api/* is rewritten to
BACKEND_URL=http://127.0.0.1:8000
