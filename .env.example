# Deno backend configuration (API, worker, scheduler all read the same file).
# Every variable is explained in docs/10_CONFIGURATION.md. Production (Cloud Run) values are set by
# deploy/deploy-free.sh and Secret Manager, see docs/09_FREE_DEPLOYMENT.md.
# Production: copy to .env.production next to compose.prod.yml. ENVIRONMENT=production refuses to
# start without SUPABASE_URL, NVIDIA_NIM_API_KEY and a postgresql DATABASE_URL.

ENVIRONMENT=development
LOG_LEVEL=info
LOG_JSON=true

# --- NVIDIA NIM (all LLM, embedding and rerank calls share one 40 req/min key) ---
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b
LLM_MODEL_STRONG=nvidia/nemotron-3-super-120b-a12b
LLM_MODEL_JUDGE=nvidia/nemotron-3-super-120b-a12b
LLM_MODEL_FALLBACK=meta/llama-3.2-11b-vision-instruct
LLM_REQUESTS_PER_MINUTE=36
# Roles that keep Nemotron "thinking" on (slower, ~10x): comma separated, e.g. judge
LLM_THINKING_ROLES=
LLM_RUN_TOKEN_BUDGET=400000
EMBED_MODEL=nvidia/nemotron-3-embed-1b
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2

# --- Data ---
# Hosted Supabase Postgres: Dashboard → Connect → Session pooler (port 5432, IPv4). Change the
# scheme to postgresql+asyncpg://. The direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
VALKEY_URL=redis://127.0.0.1:6379/0
SCRAPED_TEXT_RETENTION_DAYS=90

# --- Supabase Auth (hosted project) — see docs/supabase-setup.md ---
# Empty = auth disabled (dev only: every request is one fixed dev user)
SUPABASE_URL=
# Only for legacy projects on the shared HS256 secret
SUPABASE_LEGACY_JWT_SECRET=
# Server-side only: lets DELETE /me remove the login too
SUPABASE_SECRET_KEY=
# Browser origins allowed to call the API directly
WEB_ORIGINS=http://localhost:3000

# --- Keyless sources ---
SEARXNG_URL=http://127.0.0.1:8890
# true when SearXNG is a private Cloud Run service: requests carry a Google ID token
SEARXNG_GCP_AUTH=false
# Hosts to fetch despite robots.txt disallowing bots — only after legal review.
# e.g. www.linkedin.com,cdn.syndication.twimg.com,www.reddit.com
SOURCES_ROBOTS_OPT_IN=
SOURCES_USER_AGENT=
# Optional: GitHub token (no scopes needed) for reading repos linked in ideas; without it 60 reads/hour per IP
GITHUB_TOKEN=
TAKEDOWN_RATE_LIMIT_PER_HOUR=5

# --- Jobs (docs/09_FREE_DEPLOYMENT.md §4) ---
# taskiq = Valkey queue + worker process (compose / VPS). cloudrun_job = one Cloud Run Job execution per run.
TASK_RUNNER=taskiq
# projects/<project>/locations/<region>/jobs/<name>, only for TASK_RUNNER=cloudrun_job
CLOUDRUN_JOB=
# Cloud Scheduler -> POST /internal/cron/{purge,requeue}. Both empty = endpoints off (404).
CRON_OIDC_AUDIENCE=
CRON_SERVICE_ACCOUNT=

# --- Billing (Stripe). Billing endpoints answer 503 until these are set. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
APP_URL=http://localhost:3000

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
# Bearer token for GET /metrics (empty = loopback only). Worker metrics: :9000
METRICS_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- HTTP ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_RATE_LIMIT_PER_MINUTE=60
